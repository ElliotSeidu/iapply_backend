# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DEPLOYMENT_ENV=development

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# ── HTTPS ─────────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Content Security Policy ───────────────────────────────────────────────────
# Set to False to enforce CSP (blocks policy violations instead of just logging).
# Leave as True while you review violation reports in production.
CSP_REPORT_ONLY=True

# ── Database ──────────────────────────────────────────────────────────────────
# DB_ENGINE=sqlite3  (default — no other vars needed)
# DB_ENGINE=postgres
DB_ENGINE=sqlite3
DB_NAME=iapply_backend
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# ── Email ─────────────────────────────────────────────────────────────────────
# Development default (prints to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@iapply.app

# For production SMTP, change EMAIL_BACKEND and fill in your provider's details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com        # or smtp.sendgrid.net, mail.smtp2go.com, etc.
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password   # Use an app password, not your login password
