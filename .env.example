# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Options: development, staging, production
DEPLOYMENT_ENV=development

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# ── HTTPS & Reverse Proxy ─────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_HOST=False

# HSTS settings (active when DEBUG=False)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Content Security Policy ───────────────────────────────────────────────────
# Set to False to enforce CSP (blocks policy violations instead of just logging).
# Leave as True while you review violation reports in staging/initial rollout.
CSP_REPORT_ONLY=False

# ── Database ──────────────────────────────────────────────────────────────────
# DB_ENGINE=sqlite3  (development default — no other vars needed)
# DB_ENGINE=postgres (mandatory in production)
DB_ENGINE=sqlite3
DB_NAME=iapply_backend
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# In production, DB_SSLMODE must be require, verify-ca, or verify-full
DB_SSLMODE=prefer

# ── Email ─────────────────────────────────────────────────────────────────────
# Development default (prints to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@iapply.app

# For production SMTP, change EMAIL_BACKEND and fill in your provider's details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com        # or smtp.sendgrid.net, mail.smtp2go.com, etc.
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password   # Use an app password, not your login password

# ── Google Sign-In ────────────────────────────────────────────────────────────
# OAuth 2.0 Web application client ID from Google Cloud Console.
# Leave blank to disable Google sign-in (the frontend hides the button).
GOOGLE_CLIENT_ID=
